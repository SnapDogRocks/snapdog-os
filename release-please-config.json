{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "exclude-paths": [
        "snapdog-update/**",
        "docs/snapdog-update-release-flow.md",
        ".github/workflows/release-snapdog-update.yml"
      ]
    },
    "snapdog-ctrl": {
      "release-type": "rust",
      "changelog-path": "snapdog-ctrl/CHANGELOG.md",
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true
    },
    "snapdog-update": {
      "release-type": "rust",
      "component": "snapdog-update",
      "changelog-path": "snapdog-update/CHANGELOG.md",
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true
    }
  }
}
