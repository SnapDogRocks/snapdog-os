[Unit]
Description=SnapDog Server (multiroom audio)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/snapdog --config /etc/snapdog/snapdog.toml
Restart=on-failure
RestartSec=5
DynamicUser=yes
SupplementaryGroups=audio
ProtectHome=yes
PrivateTmp=yes
# ProtectSystem=strict is implied by DynamicUser=yes; carve out the persistent
# state directory (snapdog-data-init creates it before this unit starts).
ReadWritePaths=/data/snapdog/state

