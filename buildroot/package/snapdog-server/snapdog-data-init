#!/bin/sh
# Initialize /data partition with default config files.
# Runs on first boot after /data is mounted.
# Symlinks from /etc → /data are already baked into the image (post-build.sh).

set -eu

DATA=/data

# Retired update staging files can survive an OS upgrade because /data is
# persistent. They are no longer consumable and may occupy up to 1 GiB.
rm -f "$DATA/pending-flash.img.gz" "$DATA/pending-flash.img.gz.part"

# Create directory structure
mkdir -p "$DATA/default"
mkdir -p "$DATA/snapdog"
# snapdog.service's persistent state (zone/group Store, EQ settings, AirPlay
# pairing, server_id) lives in its own subdirectory, not directly under
# $DATA/snapdog, so widening its permissions below doesn't also affect
# snapdog.toml (which sits next to it and is written by root via snapdog-ctrl).
mkdir -p "$DATA/snapdog/state"
# snapdog.service runs as DynamicUser (a fresh, unpredictable UID each start),
# so a fixed-owner directory can't grant it write access — world-writable is
# the pragmatic tradeoff on a single-purpose device with no untrusted local
# users.
chmod 0777 "$DATA/snapdog/state"
mkdir -p "$DATA/wpa_supplicant"
mkdir -p "$DATA/hostapd"
mkdir -p "$DATA/systemd/network"
mkdir -p "$DATA/systemd/resolved.conf.d"
mkdir -p "$DATA/systemd/system/snapdog-client.service.d"
mkdir -p "$DATA/ssh"

# Write defaults if not already present
[ -f "$DATA/default/snapdog-client" ] || echo 'SNAPDOG_CLIENT_ARGS=""' > "$DATA/default/snapdog-client"
[ -f "$DATA/hostname" ] || echo "snapdog" > "$DATA/hostname"
[ -L "$DATA/localtime" ] || [ -f "$DATA/localtime" ] || ln -sf /usr/share/zoneinfo/UTC "$DATA/localtime"

# Default wired networking: DHCP on any ethernet interface (end0 on Pi4, eth0 on
# Pi3, enx* USB adapters). Seeded here — before systemd-networkd starts — so the
# device gets an IP on first boot independently of snapdog-ctrl. snapdog-ctrl may
# overwrite this file later when a static IP is configured.
if [ ! -f "$DATA/systemd/network/10-ethernet.network" ]; then
  cat > "$DATA/systemd/network/10-ethernet.network" <<'EOF'
[Match]
Name=en* eth*

[Network]
DHCP=yes
EOF
fi
